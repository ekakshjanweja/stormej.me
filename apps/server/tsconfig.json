{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ESNext"],
    "types": ["./worker-configuration.d.ts"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "baseUrl": ".",
    "paths": {
      "@stormej/shared/*": ["../../packages/shared/*"],
      "@stormej/auth": ["../../packages/auth/src/index.ts"],
      "@stormej/db": ["../../packages/db/src/index.ts"],
      "@stormej/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../../packages/shared/**/*.ts"]
}
