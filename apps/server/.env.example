# loaded by packages/infra/alchemy.run.ts (and used as Worker secrets/vars)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Better Auth base URL. The deployment config passes this to the worker.
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8787

# Google OAuth (Web client) — redirect URIs must be:
#   http://localhost:3000/api/auth/callback/google
#   https://www.stormej.me/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# private vault unlock key — generate with: openssl rand -base64 32
# only you should ever know this; it is not a password account
VAULT_ACCESS_KEY=

# Signup is disabled by default. Set this only when intentionally enabling
# email signup; it is not required for mobile sign-in.
# ALLOW_SIGNUP=true

# the lab's spotify player (served at /spotify). both or neither; get the
# refresh token with `bun run spotify:token` in apps/lab. it lasts 180 days
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
