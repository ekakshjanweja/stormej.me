# loaded by packages/infra/alchemy.run.ts (and used as Worker secrets/vars)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# local-only overrides (prod values are set in alchemy.run.ts)
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:8787

# Google OAuth (Web client) — redirect URIs must be:
#   http://localhost:3000/api/auth/callback/google
#   https://www.stormej.me/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# set to true only while seeding the first vault user (google or email), then remove it
# ALLOW_SIGNUP=true
