{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stormej",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-07",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "stormej-storage",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stormej-db",
      // replace with the id printed by `bunx wrangler d1 create stormej-db`
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../../packages/db/src/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_ROOM",
        "class_name": "RealtimeRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"],
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3000",
    "CORS_ORIGIN": "http://localhost:3000,http://localhost:8787",
  },
}
