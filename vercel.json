{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "cd ../.. && bun install"
    },
    "lab": {
      "root": "apps/lab",
      "framework": "nextjs",
      "installCommand": "cd ../.. && bun install"
    }
  },
  "rewrites": [
    {
      "source": "/experiments/(.+)",
      "destination": {
        "service": "lab"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
